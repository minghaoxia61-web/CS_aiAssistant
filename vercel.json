{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build --mode web",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/knowledge/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    }
  ]
}
