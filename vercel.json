{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/generate-static-api.cjs && vite build --mode web",
  "outputDirectory": "dist",
  "functions": {
    "api/llm/*.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api-data/config.json"
    },
    {
      "source": "/api/knowledge/catalog",
      "destination": "/api-data/catalog.json"
    },
    {
      "source": "/api/knowledge/:category/:slug",
      "destination": "/api-data/articles/:category/:slug.json"
    },
    {
      "source": "/api/knowledge",
      "destination": "/api-data/knowledge.json"
    }
  ]
}
