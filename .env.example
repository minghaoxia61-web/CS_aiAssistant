# Web 服务
PORT=3000
DATA_DIR=./data
NODE_ENV=development

# OpenAI 兼容模型服务
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=deepseek-v4-flash
# 额外 OpenAI 兼容域名，多个域名用逗号分隔
LLM_ALLOWED_HOSTS=

# 可选：账号与云同步（Supabase 浏览器端公开配置，不要填写 service_role key）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
